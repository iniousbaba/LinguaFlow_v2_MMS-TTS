# LinguaFlow environment — copy to `.env` (which is gitignored) and fill in.

# Anthropic API key — enables Claude as the last-resort translation fallback.
# Without this, translation falls back to Google -> MyMemory only.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for fallback translation.
# Default: claude-sonnet-5   (better for Yoruba/Igbo/Hausa than Haiku)
# CLAUDE_MODEL=claude-sonnet-5

# Optional: current Colab YarnGPT tunnel URL for Igbo TTS.
# The Colab notebook prints a new ngrok URL each time it restarts.
# YARNGPT_COLAB_URL=https://your-tunnel.ngrok-free.dev
